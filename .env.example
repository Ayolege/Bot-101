# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# ── Binance API ───────────────────────────────────────────────
# Create at: binance.com → Profile → API Management
# Required permissions: Read Info + Spot & Margin Trading
# IP restriction: whitelist your Tokyo VPS IP for security
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ── Proxy (only needed if running locally in Nigeria, not on VPS) ─
# Leave blank when running on Tokyo VPS — not needed there.
# Format: socks5h://user:pass@host:port  or  http://host:port
BINANCE_PROXY=

# ── Telegram alerts (optional) ────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
