# Systemd service file — copy to /etc/systemd/system/arbbot.service on the VPS
# Then run: sudo systemctl enable arbbot && sudo systemctl start arbbot

[Unit]
Description=Binance Triangular Arbitrage Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/bot-101
ExecStart=/home/ubuntu/bot-101/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
# Give the bot 30 seconds to shut down cleanly on SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
